{
  "manifest_version": 3,
  "name": "PromptGate for claude.ai",
  "version": "0.1.3",
  "description": "Scores your prompt on claude.ai (0-100) and offers three rewrites you can drop into the box. Runs locally. Nothing is sent out.",
  "permissions": ["storage"],
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["engine.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "PromptGate",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
    "default_popup": "popup.html"
  }
}
